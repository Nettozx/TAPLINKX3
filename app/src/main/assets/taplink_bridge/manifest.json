{
  "manifest_version": 2,
  "name": "TapLink Bridge",
  "version": "2.7",
  "description": "Connects pages to TapLink when it runs on the GeckoView engine.",
  "browser_specific_settings": {
    "gecko": {
      "id": "taplink-bridge@taplinkx3.app"
    }
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ],
  "content_security_policy": "script-src 'self' 'unsafe-eval'; object-src 'self'",
  "permissions": ["nativeMessaging", "nativeMessagingFromContent", "geckoViewAddons"]
}
